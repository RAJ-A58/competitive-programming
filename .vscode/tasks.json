{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Local Judge: Test Active File",
            "type": "shell",
            "command": "python",
            "args": [
                "${workspaceFolder}/judge.py",
                "${file}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Compiles and runs active C++ file against sample test cases in one command."
        },
        {
            "label": "Local Judge: Interactive Run",
            "type": "shell",
            "command": "python",
            "args": [
                "${workspaceFolder}/judge.py",
                "${file}",
                "-i"
            ],
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "showReuseMessage": false
            },
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Runs active file interactively in terminal for custom inputs."
        },
        {
            "label": "Local Judge: Add Sample Test",
            "type": "shell",
            "command": "python",
            "args": [
                "${workspaceFolder}/judge.py",
                "${file}",
                "-a"
            ],
            "group": "none",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file",
            "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "none",
            "detail": "Task generated by Debugger."
        }
    ]
}
