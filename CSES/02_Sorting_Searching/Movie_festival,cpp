#include <bits/stdc++.h>
using namespace std;

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    int n;
    if (cin >> n) {
        vector<pair<int, int>> movies;
        movies.reserve(n);
        for (int i = 0; i < n; i++) {
            int start, end;
            cin >> start >> end;
            movies.emplace_back(end, start);
        }
        sort(movies.begin(), movies.end());
        int count= 0;
        int prev_end= 0; 
        
        for (auto& movie : movies) {
            if (movie.second >= prev_end) {
                count++;
                prev_end=movie.first;
            }
        }
        cout << count << "\n";
    }
    
    return 0;
}